      "status": "complete",
      "alt": "",
      "context_before": "",
      "context_after": "● 2024 年，保时捷在中国的销量呈现出一定的波动。",
      "path": "assets/figure_002.jpg",
      "sha256": "7fffc7cbd3d71f46c917703f4fc25af5c1ed3ad29d13bf74552ff31c2e442167",
